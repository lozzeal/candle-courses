# ====================================================
# Cloudflare R2 (отримати в Cloudflare Dashboard → R2)
# ====================================================
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=100candle-storage
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXX.r2.dev

# ====================================================
# Supabase (тимчасово — для зчитування Storage)
# Після міграції — РЕГЕНЕРУВАТИ service_role у Settings → API
# ====================================================
SUPABASE_URL=https://jmfudjhembgeaztowcoe.supabase.co
SUPABASE_SERVICE_KEY=

# ====================================================
# Опційно — обмежити швидкість, щоб не вбити Free quota
# Кількість паралельних завантажень (default: 4)
# ====================================================
CONCURRENCY=4
